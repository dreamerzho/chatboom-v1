"""
聊天记录处理器
负责解析聊天记录中的文件信息、去重、人员关联等功能
整合了旧chat_parser.py中的核心功能

版本: 2.0 (重构版)
核心改动:
- 使用正则表达式重构了文件消息的解析逻辑，使其能够处理格式混乱的content内容。
- 为核心处理函数增加了群聊信息参数，为实现内外群区分的业务逻辑打下基础。
"""

import xml.etree.ElementTree as ET
import re
import logging
from datetime import datetime
from typing import Dict, List, Optional, Any, Tuple
from difflib import SequenceMatcher

logger = logging.getLogger(__name__)

class ChatMessageParser:
    """
    聊天记录解析器
    负责解析聊天记录中的各种信息，包括文件、文本、图片等
    """
    
    def __init__(self):
        """初始化解析器"""
        self.message_types = {
            1: "文本消息",
            3: "图片消息", 
            34: "语音消息",
            43: "视频消息",
            47: "动画表情",
            49: "多媒体消息",  # 包含文件、链接等
            10000: "系统消息"
        }
        
        # 定义一个正则表达式，用于从混乱的content中提取文件名
        # 它会寻找 <title> 和 </title> 之间的内容
        self.filename_regex = re.compile(r'<title>(.*?)</title>', re.DOTALL)

    def _parse_multimedia_content(self, content: str) -> Dict[str, Any]:
        """
        【核心修改】解析多媒体消息内容 (type: 49)
        旧方法直接使用XML解析，非常脆弱。新方法使用正则表达式，健壮性更强。
        """
        parsed_data = {'raw': content}
        
        # 尝试使用正则表达式从content中提取文件名
        match = self.filename_regex.search(content)
        if match:
            # 如果匹配成功，提取到的就是文件名
            filename = match.group(1).strip()
            parsed_data['filename'] = filename
            parsed_data['subtype'] = '文件' # 假定包含title的就是文件
            logger.info(f"成功从多媒体消息中解析出文件名: {filename}")
        else:
            # 如果正则匹配失败，可能是一个链接或其他类型，记录下来
            parsed_data['subtype'] = '未知多媒体'
            logger.warning(f"无法从多媒体消息中解析出文件名。Content: {content[:100]}...")

        return parsed_data

    def parse_message(self, message: Dict[str, Any]) -> Dict[str, Any]:
        """
        解析单条聊天记录
        """
        msg_type = message.get('type', 0)
        parsed_content = {}
        
        if msg_type == 1:
            parsed_content['type'] = '文本'
            parsed_content['text'] = message.get('content', '')
        elif msg_type == 49:
            parsed_content['type'] = '多媒体'
            # 调用重构后的健壮解析方法
            parsed_content.update(self._parse_multimedia_content(message.get('content', '')))
        else:
            parsed_content['type'] = self.message_types.get(msg_type, '未知类型')
            parsed_content['raw'] = message.get('content', '')

        return {
            'seq': message.get('seq'),
            'time': message.get('time'),
            'talker': message.get('talkerName'),
            'sender': message.get('senderName'),
            'isSelf': message.get('isSelf', False),
            'parsed_content': parsed_content,
        }


class ChatLogProcessor:
    """
    聊天记录处理器
    负责对整个聊天记录列表进行处理，包括去重、关联等
    """
    def __init__(self, employees: List[Dict[str, Any]]):
        self.parser = ChatMessageParser()
        self.employees = employees
        self.seen_seqs = set()

    def _associate_employee(self, sender_name: str, group_type: str) -> Tuple[Optional[Dict], str]:
        """
        将发件人姓名与员工列表进行模糊匹配
        【建议扩展】增加对客户角色的判断
        """
        if not sender_name:
            return None, 'unknown'

        best_match = None
        highest_score = 0.7  # 设置一个初始阈值，低于此值不认为是同一个人

        for employee in self.employees:
            # 可以在员工信息中加入更多别名进行匹配
            aliases = [employee.get('name', '')] + employee.get('aliases', [])
            for alias in aliases:
                score = SequenceMatcher(None, sender_name, alias).ratio()
                if score > highest_score:
                    highest_score = score
                    best_match = employee
        
        if best_match:
            return best_match, 'employee'
        
        # 【新逻辑】如果是在外部群且没匹配到员工，则认为是客户
        if group_type == 'external':
            return {'name': sender_name}, 'client'
            
        return None, 'unmatched'

    def _create_file_record(self, parsed_message: Dict[str, Any], employee: Optional[Dict], role: str, group_info: Dict) -> Optional[Dict]:
        """
        如果消息是文件，则创建一条标准化的文件记录
        """
        content = parsed_message.get('parsed_content', {})
        filename = content.get('filename')

        if not filename:
            return None

        # TODO: 在这里可以加入更灵活的文件名解析逻辑
        project_name = self._extract_project_name(filename)
        work_order = self._extract_work_order(filename)
        workload = self._extract_workload(filename)
        
        return {
            'filename': filename,
            'project_name': project_name,
            'work_order': work_order,
            'workload': workload,
            'timestamp': parsed_message.get('time'),
            'sender_name': parsed_message.get('sender'),
            'sender_role': role, # 'employee' or 'client'
            'employee_id': employee.get('id') if employee and role == 'employee' else None,
            'group_name': group_info.get('name'),
            'group_type': group_info.get('type'), # 'internal' or 'external'
            'seq': parsed_message.get('seq')
        }

    def process_and_deduplicate(self, messages: List[Dict[str, Any]], group_info: Dict) -> List[Dict]:
        """
        【核心修改】处理整个消息列表，并进行去重
        增加了 group_info 参数来接收群聊上下文信息
        """
        processed_files = []
        
        # 建议从外部确定群聊类型，例如通过群聊名称判断
        # group_info = {'name': '越城天地项目', 'type': 'internal'}
        group_type = group_info.get('type', 'unknown')

        for message in messages:
            seq = message.get('seq')
            if not seq or seq in self.seen_seqs:
                continue
            self.seen_seqs.add(seq)

            parsed_message = self.parser.parse_message(message)
            
            sender_name = parsed_message.get('sender')
            employee, role = self._associate_employee(sender_name, group_type)
            
            file_record = self._create_file_record(parsed_message, employee, role, group_info)
            if file_record:
                processed_files.append(file_record)
        
        return processed_files

    # --- 以下是文件名解析辅助函数，可以后续用更健壮的正则替换 ---
    def _extract_project_name(self, filename: str) -> str:
        parts = filename.split('-')
        return parts[1] if len(parts) > 1 else ''

    def _extract_work_order(self, filename: str) -> str:
        parts = filename.split('-')
        return parts[2] if len(parts) > 2 else ''

    def _extract_workload(self, filename: str) -> str:
        parts = filename.split('-')
        return parts[3] if len(parts) > 3 else ''

